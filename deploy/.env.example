# =====================================================================
# backend/.env — copie este arquivo para SIte-pinceleguia/.env (raiz do
# projeto, ao lado de backend/) e preencha os valores reais.
#
# NUNCA versione o .env real. NUNCA coloque este arquivo dentro de
# public_html — ele deve ficar fora do document root (ver
# README-HOSTINGER.md, "Layout de produção").
# =====================================================================

# --- Aplicação -----------------------------------------------------
APP_DEBUG=false
PUBLIC_SITE_URL=https://www.seudominio.com.br

# --- Banco de dados (hPanel > Bancos de dados MySQL) ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Frontend --------------------------------------------------------
# Caminho absoluto para o index.html gerado por `npm run build` em
# frontend/storefront. Só é usado se você optar pelo layout com
# SSR-lite (PHP como document root) — ver README-HOSTINGER.md.
FRONTEND_DIST_INDEX=

# Caminho absoluto para o index.html gerado por `npm run build` em
# frontend/admin.
ADMIN_DIST_INDEX=

# --- Painel administrativo (Fase 2) -----------------------------------
# Cookie de sessão exige HTTPS (Secure=true) por padrão — só desligue em
# desenvolvimento local sem HTTPS. NUNCA deixe "false" em produção.
COOKIE_SECURE=true

# --- Upload de imagens de produto (Fase 2) -----------------------------
# Caminho absoluto no servidor onde os arquivos são salvos. Por padrão,
# backend/public/uploads/produtos — dentro do document root, mas com
# execução de PHP desligada via .htaccess (ver backend/public/uploads/.htaccess).
UPLOAD_DIR=
# Prefixo de URL pública correspondente ao UPLOAD_DIR acima.
UPLOAD_PUBLIC_URL=/uploads/produtos

# --- SMTP da Hostinger (Fase 3 — fila de e-mail) --------------------
# Se SMTP_HOST ficar vazio, backend/cron/processar-fila-email.php sai
# sem fazer nada (não quebra, só não envia) — ver
# backend/src/Email/SmtpMailer.php.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Pincel & Guia"

# --- Mercado Pago (Fase 3 — checkout) -------------------------------
# Se MP_ACCESS_TOKEN ficar vazio, o checkout ainda cria o pedido
# normalmente, só sem meio de pagamento disponível (ver
# App\Checkout\CheckoutService::createPixPayment) — não trava a venda
# por causa de configuração pendente, mas também não finge que o
# pagamento está pronto.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=
MP_ENVIRONMENT=sandbox

# =====================================================================
# Variáveis abaixo são de FASE FUTURA (4) — ainda não consumidas por
# nenhum código até a Fase 3.
# =====================================================================

# --- Cron / jobs administrativos (Fase 4+) --------------------------
# CRON_SECRET=
