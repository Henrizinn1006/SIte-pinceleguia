# =====================================================================
# Pincel & Guia — variáveis de ambiente
#
# Copie este arquivo para .env e preencha.
# NUNCA versione o .env. NUNCA coloque credencial real aqui.
# =====================================================================

# ---------------------------------------------------------------------
# APLICAÇÃO
# ---------------------------------------------------------------------
# URL pública da aplicação (sem barra no final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# development | production | test
NODE_ENV="development"


# ---------------------------------------------------------------------
# BANCO DE DADOS  (obrigatório)
# ---------------------------------------------------------------------
# PostgreSQL. Em produção usamos Neon.
# Crie um projeto grátis em https://neon.tech e cole a connection string.
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=""

# Conexão direta (sem pooler) — usada pelas migrations do Prisma.
# No Neon, é a mesma string sem o sufixo "-pooler" no host.
DIRECT_URL=""


# ---------------------------------------------------------------------
# AUTENTICAÇÃO  (FASE 3)
# ---------------------------------------------------------------------
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"


# ---------------------------------------------------------------------
# PAGAMENTO — Mercado Pago  (FASE 4)
# ---------------------------------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel
# Em desenvolvimento use SEMPRE as credenciais de teste (sandbox).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
# A public key é exposta ao navegador por design — ela NÃO é secreta.
NEXT_PUBLIC_MP_PUBLIC_KEY=""


# ---------------------------------------------------------------------
# FRETE  (FASE 4)
# ---------------------------------------------------------------------
# flat | melhor-envio
SHIPPING_PROVIDER="flat"
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
# CEP de origem dos envios — DECISÃO PENDENTE (ver docs/10)
SHIPPING_ORIGIN_ZIPCODE=""


# ---------------------------------------------------------------------
# ARMAZENAMENTO DE IMAGENS — Cloudflare R2  (FASE 5)
# ---------------------------------------------------------------------
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""


# ---------------------------------------------------------------------
# E-MAIL TRANSACIONAL — Resend  (FASE 4)
# ---------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Pincel & Guia <nao-responda@exemplo.com.br>"


# ---------------------------------------------------------------------
# JOBS AGENDADOS  (FASE 4)
# ---------------------------------------------------------------------
# Protege /api/cron/*. Gere com: openssl rand -hex 32
CRON_SECRET=""


# ---------------------------------------------------------------------
# OBSERVABILIDADE  (opcional)
# ---------------------------------------------------------------------
SENTRY_DSN=""
